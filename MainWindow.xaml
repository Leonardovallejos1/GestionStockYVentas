<Window x:Class="GestionStockWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Stock y Ventas" Height="500" Width="720">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Sistema de Control de Stock" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Formulario de entrada -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Nombre:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtNombre" Width="120" Margin="0,0,15,0"/>

            <TextBlock Text="Precio:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtPrecio" Width="80" Margin="0,0,15,0"/>

            <TextBlock Text="Stock:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtStock" Width="60" Margin="0,0,15,0"/>

            <Button Content="Agregar Producto" Click="BtnAgregar_Click" Padding="10,5"/>
        </StackPanel>

        <!-- Tabla de Productos -->
        <DataGrid x:Name="dgInventario" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,0,15"/>

        <!-- Botones de Acción sobre el Seleccionado -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vender 1 Unidad" Click="BtnVender_Click" Padding="12,6" Margin="0,0,10,0" Background="#E1F5FE"/>
            <Button Content="Eliminar Producto" Click="BtnEliminar_Click" Padding="12,6" Background="#FFEBEE"/>
        </StackPanel>
    </Grid>
</Window>